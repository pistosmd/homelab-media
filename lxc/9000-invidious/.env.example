# Copy to .env inside the container (/opt/invidious/.env) and fill in real values.
# The real .env is never committed — see .gitignore.

# Postgres password for the `kemal` user. Any long random string.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Invidious HMAC key, used to sign tokens. Any long random string.
#   openssl rand -hex 32
HMAC_KEY=

# Shared secret between invidious and invidious-companion.
# MUST be exactly 16 characters — the companion rejects anything else.
#   openssl rand -hex 8
COMPANION_KEY=
